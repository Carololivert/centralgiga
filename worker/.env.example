# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# ⚠️ SERVICE ROLE key (Settings → API → service_role). NUNCA no frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE...
RESULT_BUCKET=resultados

# ── SGP: API oficial (Token/App) ───────────────────────────────
# Usada por Relatório de OS, Termos Agendados e Verificar Vendas (consulta de
# cliente). NÃO passa pelo login web → NÃO depende de 2FA.
SGP_BASE=https://giganetwireless.sgp.net.br
SGP_TOKEN=
SGP_APP=

# ── SmartOLT: API oficial (X-Token) ────────────────────────────
# Usada pelo Monitor de Rede (temperatura/outage das OLTs). SUBDOMAIN = o
# "xxxxx" de https://xxxxx.smartolt.com. O monitor cruza com o SGP acima.
SMARTOLT_SUBDOMAIN=
SMARTOLT_TOKEN=

# ── SGP: login web (só p/ o que a API não cobre) ───────────────
# Usado por Conferência de Checklist, Linhas Canceladas e Remover Linhas
# (raspagem da área /admin). Se o SGP exigir 2FA no login, ver SGP_2FA_SECRET.
SGP_USER=seu_usuario
SGP_PASS=sua_senha
SGP_VERIFY_SSL=false
# Segredo do app autenticador (TOTP) p/ o 2FA automático em comum/sgp_login.py:
SGP_2FA_SECRET=
# Alternativa: SGP_2FA_MANUAL=true  (digitar o código na mão — não serve no worker)

# ── FocusChat: API oficial (Token do Canal) ────────────────────
# Usada por Verificar Vendas (lista os atendimentos de VENDAS e lê as conversas
# p/ marcar recusa por cobertura/região). O token é POR CANAL (número de
# WhatsApp): um token só enxerga os chats DAQUELE canal. Use UM dos dois:
FOCUS_TOKEN=
# Vários canais (vendas entram por mais de um número) — separados por vírgula:
# FOCUS_TOKENS=token_canal1,token_canal2,token_canal3
# Legado (só scripts antigos que raspam o painel; o worker não usa):
# FOCUS_USER=
# FOCUS_PASS=

# ── Worker ─────────────────────────────────────────────────────
WORKER_POLL_SECONDS=5

# ── Monitor SmartOLT (API HTTP embarcada no worker) ────────────
# A Central (web) consome via web/server/api/monitor/*, apontando MONITOR_API_URL
# (em web/.env) para http://<este-host>:MONITOR_PORT.
MONITOR_API_ENABLED=true
MONITOR_HOST=127.0.0.1
MONITOR_PORT=5001
# Token opcional: se a web rodar em OUTRO host (ex. Vercel) e alcançar o worker
# pela rede, defina o MESMO segredo aqui e em web/.env (MONITOR_API_TOKEN).
# MONITOR_API_TOKEN=
# Suba com dados fictícios (sem SmartOLT/SGP): MONITOR_DEMO=1

# ── Agenda: sincronização diária da Produção (dashboard /producao) ──
# Todo dia neste horário (fuso de Brasília, hora em que o técnico encerra) o
# worker lê no SGP as OS finalizadas e alimenta a tabela os_producao.
PRODUCAO_SYNC_ENABLED=true
PRODUCAO_SYNC_HORA=18:00
# Além de hoje, re-lê os N dias anteriores — pega a OS encerrada às 19h30 ou
# lançada no dia seguinte (o upsert é por os_id, então não duplica nada).
PRODUCAO_SYNC_DIAS=3
